//@version=6
indicator('Supply & Demand / OrderBlocks - MTF [JP7FX Recreation]', overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ========================================
// INPUTS & SETTINGS
// ========================================

// Main Settings
group_main = "Main Settings"
pivotPeriod = input.int(5, "Pivot Period", minval=1, group=group_main, tooltip="Period for swing high/low detection")
zoneStrengthMin = input.int(1, "Minimum Zone Strength", minval=1, group=group_main, tooltip="Minimum touches required for zone validity")
maxZones = input.int(10, "Maximum Zones", minval=1, maxval=50, group=group_main, tooltip="Maximum number of zones to display")

// Zone Creation Method
group_creation = "Zone Creation Method"
useWickForDetection = input.bool(false, "Use Wick for Zone Detection", group=group_creation, tooltip="Use wick instead of open/close for zone detection")
useWickForDrawing = input.bool(false, "Use Wick for Zone Drawing", group=group_creation, tooltip="Draw zones from wick levels instead of open/close")

// Order Blocks
group_ob = "Order Blocks"
showOrderBlocks = input.bool(true, "Show Order Blocks", group=group_ob)
obMinImbalance = input.float(0.1, "Minimum Imbalance %", minval=0.01, maxval=5.0, step=0.01, group=group_ob, tooltip="Minimum imbalance percentage for order block validation")

// Multi-Timeframe
group_mtf = "Multi-Timeframe"
enableHTF1 = input.bool(true, "Enable Higher Timeframe 1", group=group_mtf)
htf1 = input.timeframe("240", "Higher Timeframe 1", group=group_mtf, tooltip="4H = 240, 1H = 60, 15m = 15, etc.")
enableHTF2 = input.bool(false, "Enable Higher Timeframe 2", group=group_mtf)
htf2 = input.timeframe("1D", "Higher Timeframe 2", group=group_mtf, tooltip="Daily = 1D, Weekly = 1W, Monthly = 1M")
showHTFLabels = input.bool(true, "Show HTF Labels", group=group_mtf)

// Zone Management
group_management = "Zone Management"
show50Percent = input.bool(true, "Show 50% Mitigation Lines", group=group_management)
deleteOnMitigation = input.bool(true, "Delete Zones on Full Mitigation", group=group_management)
deleteOnBreakout = input.bool(false, "Delete Zones on Breakout", group=group_management)
maxBarsValid = input.int(500, "Max Bars Zone Valid", minval=10, maxval=2000, group=group_management, tooltip="Maximum bars a zone remains valid")

// Bar Coloring
group_bars = "Bar Coloring"
colorBarsOnZoneCreation = input.bool(false, "Color Bars on Zone Creation", group=group_bars)

// Colors - Supply Zones
group_supply_colors = "Supply Zone Colors"
supplyColor = input.color(color.new(color.red, 85), "Supply Zone", group=group_supply_colors)
supplyBorderColor = input.color(color.red, "Supply Border", group=group_supply_colors)
supplyHTF1Color = input.color(color.new(color.maroon, 80), "Supply HTF1", group=group_supply_colors)
supplyHTF2Color = input.color(color.new(color.maroon, 75), "Supply HTF2", group=group_supply_colors)
supply50Color = input.color(color.new(color.red, 60), "Supply 50% Line", group=group_supply_colors)

// Colors - Demand Zones
group_demand_colors = "Demand Zone Colors"
demandColor = input.color(color.new(color.blue, 85), "Demand Zone", group=group_demand_colors)
demandBorderColor = input.color(color.blue, "Demand Border", group=group_demand_colors)
demandHTF1Color = input.color(color.new(color.navy, 80), "Demand HTF1", group=group_demand_colors)
demandHTF2Color = input.color(color.new(color.navy, 75), "Demand HTF2", group=group_demand_colors)
demand50Color = input.color(color.new(color.blue, 60), "Demand 50% Line", group=group_demand_colors)

// Colors - Order Blocks
group_ob_colors = "Order Block Colors"
bullishOBColor = input.color(color.new(color.green, 70), "Bullish Order Block", group=group_ob_colors)
bearishOBColor = input.color(color.new(color.orange, 70), "Bearish Order Block", group=group_ob_colors)

// Colors - Bar Coloring
group_bar_colors = "Bar Colors"
zoneCreationBarColor = input.color(color.yellow, "Zone Creation Bar", group=group_bar_colors)

// Alerts
group_alerts = "Alerts"
alertOnZoneCreation = input.bool(false, "Alert on Zone Creation", group=group_alerts)
alertOnZoneMitigation = input.bool(false, "Alert on Zone Mitigation", group=group_alerts)
alertOnOrderBlock = input.bool(false, "Alert on Order Block", group=group_alerts)

// ========================================
// TYPES & VARIABLES
// ========================================

type Zone
    float top
    float bottom
    int leftBar
    int rightBar
    int touches
    bool isSupply
    string timeframe
    box boxId
    line fiftyLine
    label labelId
    bool mitigated

type OrderBlock
    float high
    float low
    int barIndex
    bool isBullish
    label labelId

// Arrays to store zones and order blocks
var array<Zone> currentZones = array.new<Zone>()
var array<Zone> htf1Zones = array.new<Zone>()
var array<Zone> htf2Zones = array.new<Zone>()
var array<OrderBlock> orderBlocks = array.new<OrderBlock>()

// ========================================
// UTILITY FUNCTIONS
// ========================================

// Function to get price for zone detection
getPriceForDetection(isHigh) =>
    if useWickForDetection
        isHigh ? high : low
    else
        isHigh ? math.max(open, close) : math.min(open, close)

// Function to get price for zone drawing
getPriceForDrawing(isHigh) =>
    if useWickForDrawing
        isHigh ? high : low
    else
        isHigh ? math.max(open, close) : math.min(open, close)

// Swing detection - More accurate like JP7FX
isSwingHigh(index) =>
    if index < pivotPeriod or bar_index < index + pivotPeriod
        false
    else
        highPrice = getPriceForDetection(true)[index]
        isHigh = true
        // Check left side
        for i = 1 to pivotPeriod
            if highPrice <= getPriceForDetection(true)[index + i]
                isHigh := false
                break
        // Check right side only if left side passed
        if isHigh
            for i = 1 to pivotPeriod
                if highPrice <= getPriceForDetection(true)[index - i]
                    isHigh := false
                    break
        isHigh

isSwingLow(index) =>
    if index < pivotPeriod or bar_index < index + pivotPeriod
        false
    else
        lowPrice = getPriceForDetection(false)[index]
        isLow = true
        // Check left side
        for i = 1 to pivotPeriod
            if lowPrice >= getPriceForDetection(false)[index + i]
                isLow := false
                break
        // Check right side only if left side passed
        if isLow
            for i = 1 to pivotPeriod
                if lowPrice >= getPriceForDetection(false)[index - i]
                    isLow := false
                    break
        isLow

// Zone strength calculation
calculateZoneStrength(zoneTop, zoneBottom) =>
    touches = 0
    lookback = math.min(500, bar_index)
    for i = 0 to lookback
        if high[i] >= zoneBottom and low[i] <= zoneTop
            touches += 1
    touches

// Order Block detection
isBullishOrderBlock(index) =>
    if index < 2
        false
    else
        // Pattern: Red candle followed by green candle with imbalance
        prevCandle = index + 1
        currentCandle = index
        
        prevRed = close[prevCandle] < open[prevCandle]
        currentGreen = close[currentCandle] > open[currentCandle]
        
        if prevRed and currentGreen
            // Check for imbalance (gap)
            imbalance = (low[currentCandle] - high[prevCandle]) / high[prevCandle] * 100
            imbalance >= obMinImbalance
        else
            false

isBearishOrderBlock(index) =>
    if index < 2
        false
    else
        // Pattern: Green candle followed by red candle with imbalance
        prevCandle = index + 1
        currentCandle = index
        
        prevGreen = close[prevCandle] > open[prevCandle]
        currentRed = close[currentCandle] < open[currentCandle]
        
        if prevGreen and currentRed
            // Check for imbalance (gap)
            imbalance = (low[prevCandle] - high[currentCandle]) / low[prevCandle] * 100
            imbalance >= obMinImbalance
        else
            false

// ========================================
// ZONE MANAGEMENT FUNCTIONS
// ========================================

// Create a new zone
createZone(isSupply, zoneTop, zoneBottom, barIdx, tf = "") =>
    if array.size(currentZones) >= maxZones
        oldestZone = array.get(currentZones, 0)
        if not na(oldestZone.boxId)
            box.delete(oldestZone.boxId)
        if not na(oldestZone.fiftyLine)
            line.delete(oldestZone.fiftyLine)
        if not na(oldestZone.labelId)
            label.delete(oldestZone.labelId)
        array.remove(currentZones, 0)
    
    // Use extend.right to make zones extend infinitely to the right
    // This prevents zones from moving with the chart
    
    // Choose colors based on timeframe and type
    boxColor = isSupply ? supplyColor : demandColor
    borderColor = isSupply ? supplyBorderColor : demandBorderColor
    fiftyColor = isSupply ? supply50Color : demand50Color
    
    if tf == htf1 and enableHTF1
        boxColor := isSupply ? supplyHTF1Color : demandHTF1Color
    else if tf == htf2 and enableHTF2
        boxColor := isSupply ? supplyHTF2Color : demandHTF2Color
    
    // Create box with extend.right so it doesn't move with chart
    boxId = box.new(barIdx, zoneTop, barIdx + 1, zoneBottom, bgcolor=boxColor, border_color=borderColor, border_width=1, extend=extend.right)
    
    // Create 50% line with extend.right
    fiftyLevel = (zoneTop + zoneBottom) / 2
    fiftyLine = show50Percent ? line.new(barIdx, fiftyLevel, barIdx + 1, fiftyLevel, color=fiftyColor, style=line.style_dashed, width=1, extend=extend.right) : na
    
    // Create label
    labelText = isSupply ? "S" : "D"
    if tf != ""
        labelText += " " + tf
    
    labelId = label.new(barIdx, isSupply ? zoneTop : zoneBottom, labelText, style=isSupply ? label.style_label_down : label.style_label_up, color=boxColor, textcolor=color.white, size=size.small)
    
    // Create zone object - no need to track rightBar anymore
    newZone = Zone.new(zoneTop, zoneBottom, barIdx, barIdx + 1, 1, isSupply, tf, boxId, fiftyLine, labelId, false)
    array.push(currentZones, newZone)
    
    newZone

// Update zone extensions - No longer needed with extend.right
// updateZoneExtensions() => na

// Check zone mitigation
checkZoneMitigation() =>
    if array.size(currentZones) > 0
        for i = array.size(currentZones) - 1 to 0
            zone = array.get(currentZones, i)
            if not zone.mitigated
                if zone.isSupply
                    if low <= zone.bottom
                        zone.mitigated := true
                        if alertOnZoneMitigation
                            alert("Supply zone mitigated at " + str.tostring(zone.bottom), alert.freq_once_per_bar)
                        if deleteOnMitigation
                            if not na(zone.boxId)
                                box.delete(zone.boxId)
                            if not na(zone.fiftyLine)
                                line.delete(zone.fiftyLine)
                            if not na(zone.labelId)
                                label.delete(zone.labelId)
                            array.remove(currentZones, i)
                else
                    if high >= zone.top
                        zone.mitigated := true
                        if alertOnZoneMitigation
                            alert("Demand zone mitigated at " + str.tostring(zone.top), alert.freq_once_per_bar)
                        if deleteOnMitigation
                            if not na(zone.boxId)
                                box.delete(zone.boxId)
                            if not na(zone.fiftyLine)
                                line.delete(zone.fiftyLine)
                            if not na(zone.labelId)
                                label.delete(zone.labelId)
                            array.remove(currentZones, i)

// ========================================
// MAIN LOGIC
// ========================================

// Current timeframe zone detection - Only check recent swing points
if barstate.isconfirmed
    // Check for new swing highs (Supply zones)
    if isSwingHigh(pivotPeriod)
        // Get the actual price at the swing point and store it as fixed values
        swingHigh = getPriceForDrawing(true)[pivotPeriod]
        zoneTop = swingHigh
        zoneBottom = swingHigh * 0.9995  // Create zone thickness
        strength = calculateZoneStrength(zoneTop, zoneBottom)
        
        if strength >= zoneStrengthMin
            swingBarIndex = bar_index - pivotPeriod
            zone = createZone(true, zoneTop, zoneBottom, swingBarIndex)
            if alertOnZoneCreation
                alert("New supply zone created at " + str.tostring(zoneTop), alert.freq_once_per_bar)
    
    // Check for new swing lows (Demand zones)
    if isSwingLow(pivotPeriod)
        // Get the actual price at the swing point and store it as fixed values
        swingLow = getPriceForDrawing(false)[pivotPeriod]
        zoneBottom = swingLow
        zoneTop = swingLow * 1.0005  // Create zone thickness
        strength = calculateZoneStrength(zoneTop, zoneBottom)
        
        if strength >= zoneStrengthMin
            swingBarIndex = bar_index - pivotPeriod
            zone = createZone(false, zoneTop, zoneBottom, swingBarIndex)
            if alertOnZoneCreation
                alert("New demand zone created at " + str.tostring(zoneBottom), alert.freq_once_per_bar)

// Order Block detection - Check recent patterns
if showOrderBlocks and barstate.isconfirmed
    // Check for bullish order block (looking back 2 bars)
    if isBullishOrderBlock(2)
        obHigh = high[2]
        obLow = low[2]
        obBarIndex = bar_index - 2
        labelId = label.new(obBarIndex, obLow, "BOB", style=label.style_label_up, color=bullishOBColor, textcolor=color.white, size=size.small)
        
        ob = OrderBlock.new(obHigh, obLow, obBarIndex, true, labelId)
        array.push(orderBlocks, ob)
        
        if alertOnOrderBlock
            alert("Bullish Order Block detected", alert.freq_once_per_bar)
    
    // Check for bearish order block (looking back 2 bars)
    if isBearishOrderBlock(2)
        obHigh = high[2]
        obLow = low[2]
        obBarIndex = bar_index - 2
        labelId = label.new(obBarIndex, obHigh, "SOB", style=label.style_label_down, color=bearishOBColor, textcolor=color.white, size=size.small)
        
        ob = OrderBlock.new(obHigh, obLow, obBarIndex, false, labelId)
        array.push(orderBlocks, ob)
        
        if alertOnOrderBlock
            alert("Bearish Order Block detected", alert.freq_once_per_bar)

// Higher Timeframe Analysis - Move request.security outside conditionals
// Only request HTF data if timeframes are valid and higher than current
htf1Valid = enableHTF1 and timeframe.in_seconds() < timeframe.in_seconds(htf1)
htf2Valid = enableHTF2 and timeframe.in_seconds() < timeframe.in_seconds(htf2)

// HTF1 Data
[htfHigh, htfLow, htfClose, htfOpen] = request.security(syminfo.tickerid, htf1, [high, low, close, open])

// HTF2 Data  
[htf2High, htf2Low, htf2Close, htf2Open] = request.security(syminfo.tickerid, htf2, [high, low, close, open])

// HTF1 Analysis
if htf1Valid and barstate.isconfirmed
    // HTF Supply zones - only create on HTF high change
    if ta.change(htfHigh) != 0 and htfHigh > htfHigh[1]
        zoneTop = htfHigh
        zoneBottom = zoneTop * 0.9985  // Slightly thicker HTF zones
        zone = createZone(true, zoneTop, zoneBottom, bar_index, htf1)
    
    // HTF Demand zones - only create on HTF low change
    if ta.change(htfLow) != 0 and htfLow < htfLow[1]
        zoneBottom = htfLow
        zoneTop = zoneBottom * 1.0015  // Slightly thicker HTF zones
        zone = createZone(false, zoneTop, zoneBottom, bar_index, htf1)

// HTF2 Analysis
if htf2Valid and barstate.isconfirmed
    // HTF2 Supply zones - only create on HTF2 high change
    if ta.change(htf2High) != 0 and htf2High > htf2High[1]
        zoneTop = htf2High
        zoneBottom = zoneTop * 0.997  // Thicker HTF2 zones
        zone = createZone(true, zoneTop, zoneBottom, bar_index, htf2)
    
    // HTF2 Demand zones - only create on HTF2 low change
    if ta.change(htf2Low) != 0 and htf2Low < htf2Low[1]
        zoneBottom = htf2Low
        zoneTop = zoneBottom * 1.003  // Thicker HTF2 zones
        zone = createZone(false, zoneTop, zoneBottom, bar_index, htf2)

// Check zone mitigation
checkZoneMitigation()

// Bar coloring
barcolor(colorBarsOnZoneCreation and (isSwingHigh(0) or isSwingLow(0)) ? zoneCreationBarColor : na, title="Zone Creation Bars")

// Clean up old order blocks (keep last 20)
if array.size(orderBlocks) > 20
    while array.size(orderBlocks) > 20
        ob = array.get(orderBlocks, 0)
        if not na(ob.labelId)
            label.delete(ob.labelId)
        array.remove(orderBlocks, 0)

// Performance optimization - limit zone history
if array.size(currentZones) > maxZones * 2
    for i = array.size(currentZones) - 1 to maxZones
        zone = array.get(currentZones, i)
        if bar_index - zone.leftBar > maxBarsValid
            if not na(zone.boxId)
                box.delete(zone.boxId)
            if not na(zone.fiftyLine)
                line.delete(zone.fiftyLine)
            if not na(zone.labelId)
                label.delete(zone.labelId)
            array.remove(currentZones, i)